# --- Stellar / Soroban (public: safe to expose to the browser) ---
NEXT_PUBLIC_NETWORK=TESTNET
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_CONTRACT_ID=CAQVSBNVL7OI66IDTYCR7XL4VJKMSOYGBW5D6SWLTWTINTCQO2OGCSXS
NEXT_PUBLIC_TOKEN_ID=CA3DMMHKAEV555MKWZB5AFXWB6LVZRETYNUO5ZCFGSENQOC7A2FL5HNU
NEXT_PUBLIC_TOKEN_DECIMALS=7
NEXT_PUBLIC_TOKEN_SYMBOL=USDC

# --- Faucet (server-only: DO NOT prefix with NEXT_PUBLIC) ---
# Secret key (S...) of the test-USDC issuer, used by /api/faucet to mint test USDC.
USDC_ISSUER_SECRET=

# --- Faucet rate limiting (server-only, optional) ---
# Without these, rate limiting is in-memory (per-instance, best-effort).
# With either set, limits are enforced globally across all instances.

# Per-IP limit: max mints per IP per hour (default: 5)
RATE_LIMITER_IP_LIMIT_PER_HOUR=5

# Global daily cap: max total tokens minted per day in base units (default: 100_000_000_000, i.e. 10,000 USDC @ 7 decimals)
RATE_LIMITER_GLOBAL_DAILY_CAP=100000000000

# Upstash Redis backend (optional; enables global rate limiting):
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

# OR Vercel KV backend (optional; enables global rate limiting):
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...

# --- Feedback (server-only, optional) ---
# Webhook that /api/feedback forwards submissions to (Slack/Discord/Zapier/Make).
# Leave blank to just log server-side.
FEEDBACK_WEBHOOK_URL=

# --- Sentry (optional; build works without these) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
